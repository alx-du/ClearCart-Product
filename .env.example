TAVILY_API_KEY=your_tavily_api_key_here

# Any OpenAI-compatible chat-completions URL. Normally the pages-ai-proxy
# (https://github.com/Ethical-Tech-CoLab/pages-ai-proxy), which holds the
# provider token and routes the model id to a cloud API or a B3IQ GPU model.
# For a local proxy (node local-server.mjs in that repo):
AI_ENDPOINT=http://localhost:8788/v1/chat/completions
# Model id as the endpoint knows it, e.g. gpt-5-mini, or qwen3:14b for a local model.
AI_MODEL=gpt-5-mini
# Optional: a smaller/faster model for the product-naming step (defaults to AI_MODEL).
# AI_NAMING_MODEL=
# Optional: reasoning_effort for the naming step, only for models that accept it
# (e.g. "minimal" for gpt-5-mini; leave unset for models that reject it).
# AI_NAMING_REASONING_EFFORT=minimal
# Origin header to send to the proxy; must be in the proxy's ALLOWED_ORIGINS
# (not needed if the proxy allows "*").
# AI_PROXY_ORIGIN=https://alx-du.github.io
# Only when AI_ENDPOINT is a provider directly rather than the proxy.
# AI_API_KEY=

# Browser origins allowed to call this API cross-origin (the GitHub Pages site).
# CORS_ORIGINS=https://alx-du.github.io

PORT=8787
